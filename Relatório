//Esta função se chama "perguntarContinuar":
int perguntarContinuar() { 
    int continuar;

    printf("Gostaria de continuar tentando? (1 - Sim, 0 - Não): ");
    scanf("%d", &continuar);

    if (continuar == 0) {
        printf("--Você desistiu do jogo!--\n");
        printf("Status do Jogo: Desistência!\n");
        return 1; 
    } else {
        printf("Vamos continuar tentando\n");
        return 0; 
    }
}
//Essa função é responsável por perguntar ao usuário se ele deseja continuar tentando ou desistir do jogo. 
//Ela lê a resposta do usuário e retorna um valor indicando a escolha do usuário (1 para desistir, 0 para continuar). 
//Se o usuário escolher desistir, a função imprime uma mensagem de desistência e retorna 1. Caso contrário, ela imprime uma mensagem de continuação e retorna 0.

